{
  "info": {
    "title": "IB Group Provider Backend",
    "description": "Documentacion base del backend con autenticacion, usuarios, logging y health check.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Autenticacion de usuarios"
    },
    {
      "name": "user",
      "description": "Operaciones de usuario"
    },
    {
      "name": "monitoring",
      "description": "Endpoints de monitoreo basico"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@demo.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "RegisterUserRequest": {
        "type": "object",
        "required": ["name", "email", "password", "role_id"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Admin IB"
          },
          "email": {
            "type": "string",
            "example": "admin@demo.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          },
          "role_id": {
            "type": "integer",
            "example": 1
          },
          "is_ldap": {
            "type": "boolean",
            "example": false
          },
          "mfa_enabled": {
            "type": "boolean",
            "example": false
          },
          "is_active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "SeedUserRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Administrador Desarrollo"
          },
          "email": {
            "type": "string",
            "example": "admin@admin.com"
          },
          "password": {
            "type": "string",
            "example": "123"
          },
          "role_name": {
            "type": "string",
            "example": "admin"
          },
          "role_description": {
            "type": "string",
            "example": "Rol administrador para entorno local"
          },
          "is_ldap": {
            "type": "boolean",
            "example": false
          },
          "mfa_enabled": {
            "type": "boolean",
            "example": true
          },
          "is_active": {
            "type": "boolean",
            "example": true
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["monitoring"],
        "summary": "Health check del servicio",
        "responses": {
          "200": {
            "description": "Servicio disponible"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso"
          },
          "400": {
            "description": "Datos incompletos"
          },
          "401": {
            "description": "Credenciales invalidas"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Cerrar sesion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout exitoso"
          },
          "401": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/api/v1/user": {
      "get": {
        "tags": ["user"],
        "summary": "Listar usuarios",
        "responses": {
          "200": {
            "description": "Listado de usuarios"
          }
        }
      }
    },
    "/api/v1/user/register": {
      "post": {
        "tags": ["user"],
        "summary": "Registrar usuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado"
          },
          "400": {
            "description": "Datos invalidos"
          },
          "409": {
            "description": "Email duplicado"
          }
        }
      }
    },
    "/api/v1/user/seed": {
      "post": {
        "tags": ["user"],
        "summary": "Crear o actualizar usuario semilla para desarrollo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario sembrado"
          },
          "200": {
            "description": "Usuario actualizado por seeder"
          },
          "400": {
            "description": "Datos invalidos"
          },
          "403": {
            "description": "No permitido fuera de desarrollo"
          }
        }
      }
    }
  }
}
